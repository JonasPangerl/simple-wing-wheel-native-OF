FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Start from the OpenFOAM defaults, then relax the limits. A layer-heavy
// external aero mesh needs looser limits than the defaults, otherwise
// snappyHexMesh discards layer cells and coverage collapses.
#includeEtc "caseDicts/meshQualityDict"

//- Non-orthogonality: 75 deg here, the default is 65
maxNonOrtho         75;

//- Internal skewness: 6 here, the default is 4
maxInternalSkewness 6;

//- Boundary skewness, as before
maxBoundarySkewness 20;

//- Face interpolation weight (0 -> 0.5)
minFaceWeight       0.05;

//- Cell volume ratio across a face
minVolRatio         1e-4;

//- Cell determinant
minDeterminant      1e-4;

//- Face twist
minTwist            0.05;

//- Tetrahedral quality. Deliberately permissive: with absolute layer
//  thicknesses on a curved surface, enforcing a positive tet quality costs
//  most of the layer coverage.
minTetQuality       -1e30;


// ---------------------------------------------------------------------------
// Relaxed limits for the late layer-addition iterations
// ---------------------------------------------------------------------------
// addLayersControls/nRelaxedIter in snappyHexMeshDict switches to these after
// 20 layer iterations, so that layers which only slightly violate the limits
// above are kept rather than discarded.
//
// REQUIRED whenever nRelaxedIter is set. snappyLayerDriver does a plain
// subDict("relaxed") and the run aborts with
//   Entry 'relaxed' not found in dictionary "meshQualityControls"
// if it is missing - and it aborts *after* the layers have been built, so
// around 40 minutes of meshing are lost.
//
// This block REPLACES the settings above rather than being merged with them,
// so it is written out in full instead of relying on parent-scope lookup.
relaxed
{
    #includeEtc "caseDicts/meshQualityDict"

    maxNonOrtho         80;
    maxInternalSkewness 8;
    maxBoundarySkewness 25;
    minFaceWeight       0.02;
    minVolRatio         1e-5;
    minDeterminant      1e-5;
    minTwist            0.02;
    minTetQuality       -1e30;
}


