FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<case>/include/caseParameters"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    $turbL;
        k               k;
        value           uniform $omegaInlet;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
        value           uniform $omegaInlet;
    }

    symmetry
    {
        type            symmetry;
    }

    "(side|sky)"
    {
        type            slip;
    }

    // omegaWallFunction blends the viscous-sublayer and log-layer forms, so it
    // is already the all-y+ treatment.
    //
    // One literal entry per wall group. These MUST NOT be collapsed into a
    // regex: OpenFOAM resolves patch groups only for literal keywords, and
    // matches regex keys against patch *names* only. A regex here would leave
    // every wing and wheel patch unset and abort the solver.
    ground
    {
        type            omegaWallFunction;
        value           uniform $omegaInlet;
    }

    wingGroup
    {
        $ground;
    }

    wheelRotating
    {
        $ground;
    }

    wheelGround
    {
        $ground;
    }
}


