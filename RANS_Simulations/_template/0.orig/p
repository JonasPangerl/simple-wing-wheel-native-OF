FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<case>/include/caseParameters"

// simpleFoam is incompressible: p is kinematic pressure, p/rho, in m^2/s^2.
// Multiply by rhoInf to get Pa.
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $pRef;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform $pRef;
    }

    symmetry
    {
        type            symmetry;
    }

    "(side|sky)"
    {
        type            slip;
    }

    // One literal entry per wall group. These MUST NOT be collapsed into a
    // regex such as "(ground|wingGroup|...)": OpenFOAM resolves patch groups
    // only for literal keywords, and matches regex keys against patch *names*
    // only. A regex here would leave every wing and wheel patch unset and
    // abort the solver with "Cannot find patchField entry".
    ground
    {
        type            zeroGradient;
    }

    wingGroup
    {
        $ground;
    }

    wheelRotating
    {
        $ground;
    }

    wheelGround
    {
        $ground;
    }
}


