FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Plain kOmegaSST. Native OpenFOAM has no curvature correction and no
// separation fix for it, so two limitations are worth knowing:
//   - no curvature correction, so the endplate and wheel vortex cores will
//     diffuse somewhat faster
//   - no separation fix, so separation onset on the suction side may differ
// The near-wall treatment is handled by the continuous all-y+ wall functions
// in 0.orig (see docs/07_case_reference.md).

simulationType  RAS;

RAS
{
    RASModel        kOmegaSST;

    turbulence      on;

    printCoeffs     on;
}


