# ===========================================================================
# project.env - machine-specific settings
#
# Copy this file to env/project.env and edit it for your machine.
# env/project.env is gitignored, so your paths never end up in the repo.
#
#   cp env/project.env.example env/project.env
#   ${EDITOR:-vi} env/project.env
#
# Everything in here is machine- or user-specific. Nothing that defines the
# physics belongs here - that lives in the case template.
# ===========================================================================


# ---------------------------------------------------------------------------
# OpenFOAM installation  (REQUIRED)
# ---------------------------------------------------------------------------
# Absolute path to the etc/bashrc of your OpenFOAM installation.
#
# This project targets OpenFOAM v2606 (ESI/OpenCFD, api 2606). It will refuse
# to run against an api below 2306; between 2306 and 2606 it warns and
# continues, because the case dictionaries avoid version-specific syntax.
#
# Typical locations:
#   /opt/openfoam/OpenFOAM-v2606/etc/bashrc
#   $HOME/OpenFOAM/OpenFOAM-v2606/etc/bashrc
#   /usr/lib/openfoam/openfoam2606/etc/bashrc     (deb/rpm packages)
OPENFOAM_BASHRC=""

# If your cluster uses environment modules and you need some loaded *before*
# sourcing OpenFOAM, list them here (space separated). Leave empty if not.
#   MODULES_TO_LOAD="gcc/12.2.0 mpi/openmpi-x86_64"
MODULES_TO_LOAD=""


# ---------------------------------------------------------------------------
# Parallelism  (per case)
# ---------------------------------------------------------------------------
# MPI ranks for one case: used for decomposePar, snappyHexMesh and simpleFoam.
# This is the parallelism *inside* one simulation. Running several cases at
# the same time is controlled separately, in campaign/campaign.yaml.
#
# Pick a number your node can actually feed. The baseline mesh is ~19 M cells,
# which wants roughly 1.5 GB of RAM per million cells during meshing.
NP=8

# Extra arguments passed to mpirun. Usually empty.
# OpenMPI on a single node without InfiniBand often wants:
#   MPIRUN_ARGS="--bind-to core --map-by socket"
# Inside a container or when oversubscribing:
#   MPIRUN_ARGS="--oversubscribe"
MPIRUN_ARGS=""


# ---------------------------------------------------------------------------
# Optional: ParaView for the image post-processing
# ---------------------------------------------------------------------------
# Absolute path to pvbatch. Leave empty to skip image rendering; the force
# and residual post-processing does not need ParaView.
PVBATCH=""
